# ColdStart environment — copy this file to `.env` and fill in the real values.
# IMPORTANT: names only, no real values. `.env` is gitignored and never committed.
# The agent reads these from process.env at runtime (sourced in-shell by scripts).

# Solari API key — grab one at https://console.getsolari.com
SOLARI_API_KEY=

# Vision-first agent model (OpenAI-compatible chat/completions endpoint)
LLM_API_KEY=
LLM_ENDPOINT=
LLM_MODEL=
