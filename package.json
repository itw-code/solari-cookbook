{
  "name": "coldstart-solari-cookbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ColdStart: a zero-shot generalization harness for computer-use agents on Solari.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "gen:variants": "tsx src/generate-variants/index.ts",
    "verify": "npm run typecheck && npm test",
    "docs:serve": "python -m http.server 8080 --directory docs",
    "run:orchestrate": "bash scripts/run-step-03.sh",
    "run:scorecard": "bash scripts/run-step-06.sh",
    "run:isolated": "bash scripts/run-step-06b.sh",
    "demo:all": "tsx scripts/run-combined-demo.ts && tsx scripts/render-demo-report.ts",
    "build:slop-gif": "tsx scripts/build-slop-gif.ts",
    "serve": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@solarisdk/browser": "^0.1.1",
    "@solarisdk/sdk": "^0.1.2"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2"
  }
}
