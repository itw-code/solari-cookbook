{
  "schema_id": "invoice_entry",
  "target_url_pattern": "*invoice*",
  "submit_affordance_hint": "Submit",
  "success_indicator_pattern": "Confirmation|Receipt|Posted|Reference",
  "fields": [
    {"field_name": "vendor_name", "target_role": "textbox", "label_hints": ["Vendor Name", "Vendor", "Supplier"]},
    {"field_name": "tax_id", "target_role": "textbox", "label_hints": ["Tax ID", "VAT", "EIN"], "format_transformer": "strip_dashes"},
    {"field_name": "invoice_number", "target_role": "textbox", "label_hints": ["Invoice Number", "Invoice #", "Invoice No"]},
    {"field_name": "invoice_date", "target_role": "textbox", "label_hints": ["Invoice Date"], "format_transformer": "date_iso"},
    {"field_name": "total_amount", "target_role": "textbox", "label_hints": ["Total Amount", "Amount Due", "Total"]},
    {"field_name": "payment_terms", "target_role": "textbox", "label_hints": ["Payment Terms", "Terms"], "required": false}
  ]
}
